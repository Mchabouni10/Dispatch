// prisma/models/driver.prisma
model Driver {
  id                    String   @id @default(cuid())
  // ─── IDENTITY ───
  name                  String
  employeeId            String   @unique
  phone                 String   @db.VarChar(20)
  email                 String   @db.VarChar(100)
  photo                 String?  @db.VarChar(255)
  address               String?
  dateOfBirth           DateTime?
  gender                String?  @db.VarChar(10)
  
  // ─── AVAILABILITY ───
  status                String   @default("Available")
  statusReason          String?
  leaveStart            DateTime?
  leaveEnd              DateTime?
  
  // ─── SCHEDULE ───
  schedule              String   @db.VarChar(100)
  shiftStart            String?  @db.VarChar(5)
  shiftEnd              String?  @db.VarChar(5)
  daysOff               String[]
  availableOnDaysOff    Boolean  @default(false)
  overtimePreference    Boolean  @default(false)
  maxWeeklyHours        Int      @default(60)
  
  // ─── VEHICLE ELIGIBILITY ───
  licenseNumber         String?
  licenseClass          String   @default("A") @db.VarChar(1)
  licenseExpiration     DateTime?
  licensePhoto          String?  @db.VarChar(255)
  medicalCertExpiration DateTime?
  endorsements          String[]
  vehicleTypes          String[]
  trailerEligible       Boolean  @default(true)
  hazmatCertified       Boolean  @default(false)
  gdpTrained            Boolean  @default(false)
  
  // ─── TRACKING ───
  currentLocation       String?  
  currentLatitude       Float?
  currentLongitude      Float?
  lastCheckin           DateTime?
  hoursDrivenToday      Float    @default(0)
  onDutyHours           Float    @default(0)
  lastBreakTime         DateTime?
  breakUntil            DateTime?
  shiftStartTime        DateTime?
  shiftEndTime          DateTime?
  
  // ─── PREFERENCES ───
  preferredRunTypes     String[]
  homeBase              String?  
  maxRadius             Int?     
  overnightAllowed      Boolean  @default(true)
  crossBorder           Boolean  @default(false)
  
  // ─── PERFORMANCE ───
  performanceRating     Float?   @default(3.0)
  totalTripsCompleted   Int      @default(0)
  onTimeDeliveryRate    Float?   @default(100.0)
  safetyScore           Float?   @default(100.0)
  incidents             Int      @default(0)
  
  // ─── COMPENSATION ───
  hireDate              DateTime?
  employmentStatus      String   @default("Active")
  payType               String   @default("Hourly")
  payRate               Float    @default(0)
  overtimeRate          Float?   
  bonusEligible         Boolean  @default(false)
  lastPayRaise          DateTime?
  
  // ─── CONTACT ───
  emergencyContactName  String?
  emergencyContactPhone String?  @db.VarChar(20)
  emergencyContactRelation String?
  
  // ─── NOTES ───
  notes                 String?
  specialSkills         String?
  medicalConditions     String?  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // ─── RELATIONS ───
  trips                 Trip[]
  assignedEquipment     Equipment[]
  equipmentHandoffs     EquipmentHandoff[]                    // primary driver on the handoff
  handoffsAsApprover    EquipmentHandoff[] @relation("ApproverDriver")  // when this driver is the dispatcher/approver
}