// prisma/models/trip.prisma
model Trip {
  id                       String   @id @default(cuid())
  tripNumber               String   @unique
  runType                  String
  plannedDepartureTime     DateTime?
  expectedCompletionTime   DateTime?
  startTime                DateTime?
  finishTime               DateTime?
  status                   String   @default("Scheduled")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  driverId   String?
  truckId    String?
  trailerId  String?
  driver     Driver?    @relation(fields: [driverId], references: [id])
  truck      Equipment? @relation("TruckTrips", fields: [truckId], references: [id])
  trailer    Equipment? @relation("TrailerTrips", fields: [trailerId], references: [id])

  shipmentIds String[]
  shipments   Shipment[] @relation("ShipmentTrips")

  // ─── BACKUP / SPLIT RUNS ───
  // When one truck/trailer can't take the whole manifest, a backup trip is
  // created and linked back to the original run it was split from. The
  // parent stays the "primary" trip; children are the backup driver(s).
  parentTripId String?
  parentTrip   Trip?   @relation("TripSplits", fields: [parentTripId], references: [id])
  splitTrips   Trip[]  @relation("TripSplits")

  // How much of a given AWB (Shipment) is actually riding on THIS trip.
  // Only populated once a shipment's pieces/weight are divided across more
  // than one trip — an unsplit shipment on a single trip is assumed to
  // carry that shipment's full pieces/weight.
  shipmentSplits TripShipmentSplit[]

  // POD / signature capture when the run is finished
  handoff TripHandoff?

  // Per-shipment problems at handoff (short / rejected / damaged)
  exceptions ShipmentException[]

  // Equipment handoffs created specifically for this trip
  // (reason DISPATCH + tripId set). Morning handoffs stay tripId: null.
  // Used by releaseTripCreatedCheckouts so cancel only frees dispatch checkouts.
  equipmentHandoffs EquipmentHandoff[]
}

// One AWB permit is sometimes too big for one trailer. This table records
// how many pieces / how much weight of a single Shipment are assigned to
// a specific Trip, so a permit can be divided across a primary run and one
// or more backup runs without losing track of the total.
model TripShipmentSplit {
  id         String   @id @default(cuid())
  tripId     String
  shipmentId String
  pieces     Int
  weight     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([tripId, shipmentId])
}