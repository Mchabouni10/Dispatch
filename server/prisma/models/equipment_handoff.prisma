// prisma/models/equipment_handoff.prisma

enum EquipmentHandoffAction {
  CHECKOUT
  SWAP
  RETURN
  REPLACE
}

enum EquipmentHandoffReason {
  SHIFT_START
  SHIFT_END
  MECHANICAL
  MAINTENANCE
  ROUTE_CHANGE
  DRIVER_REQUEST
  DISPATCH
  EMERGENCY
  TRAILER_SWAP
  RELOCATION
  BREAKDOWN
}

model EquipmentHandoff {
  id              String   @id @default(cuid())
  
  // What happened
  action          EquipmentHandoffAction
  reason          EquipmentHandoffReason?
  reasonNote      String?
  
  // Who - Driver (primary)
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id])
  
  // Who - Dispatcher (optional approver)
  dispatcherId    String?
  dispatcher      Driver?  @relation("ApproverDriver", fields: [dispatcherId], references: [id])
  
  // Equipment involved (primary)
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  
  // For swaps: what was replaced
  replacedEquipmentId String?
  replacedEquipment   Equipment? @relation("ReplacedEquipment", fields: [replacedEquipmentId], references: [id])
  
  // Trailer tracking
  trailerId       String?
  trailer         Equipment? @relation("TrailerHandoff", fields: [trailerId], references: [id])
  previousTrailerId String?
  
  // Timing
  checkOutTime    DateTime @default(now())
  returnTime      DateTime?
  shiftStartTime  DateTime?
  shiftEndTime    DateTime?
  
  // Location
  checkOutLocation String?
  returnLocation  String?
  
  // Vehicle data
  odometerStart   Int?
  fuelLevelStart  String?
  odometerEnd     Int?
  fuelLevelEnd    String?
  
  // Condition checks
  preTripCompleted Boolean @default(false)
  preTripNotes    String?
  postTripCompleted Boolean @default(false)
  postTripNotes   String?
  
  // Damage reporting
  damageReported  Boolean @default(false)
  damageDescription String?
  damagePhoto     String?
  
  // Status tracking
  isActive        Boolean @default(true)
  returnedBy      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([driverId])
  @@index([equipmentId])
  @@index([trailerId])
  @@index([checkOutTime])
  @@index([isActive])
  @@index([action])
}