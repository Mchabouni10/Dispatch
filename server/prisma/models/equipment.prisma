model Equipment {
  id                     String    @id @default(cuid())
  unitNumber             String    @unique
  equipmentType          String
  category               String
  status                 String    @default("In Service")
  licensePlate           String?
  vin                    String?
  year                   Int?
  modelDetails           String?
  capacityLbs            Int?
  palletPositions        Int?
  registrationExpiration DateTime?
  nextMaintenanceDue     DateTime?
  outOfServiceReason     String?
  notes                  String?

  // Unit photos (paths under /uploads/equipment) — exterior, interior, damage, plate, etc.
  images                 String[]  @default([])

  // ─── INSURANCE ───
  insuranceProvider      String?
  insurancePolicyNumber  String?
  insuranceExpiration    DateTime?

  // ─── IFTA / IRP ───
  iftaIrpExpiration      DateTime?

  // ─── OWNERSHIP / LEASE ───
  ownershipType          String    @default("Owned")
  leaseCompany           String?
  leaseEndDate           DateTime?
  monthlyPaymentAmount   Float?

  // ─── HANDOFF BOARD ───
  assignedDriverId       String?
  assignedDriver         Driver?   @relation(fields: [assignedDriverId], references: [id])
  availableAt            DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // ─── RELATIONS ───
  tripsAsTruck           Trip[]             @relation("TruckTrips")
  tripsAsTrailer         Trip[]             @relation("TrailerTrips")
  handoffs               EquipmentHandoff[]
  handoffsAsReplaced     EquipmentHandoff[] @relation("ReplacedEquipment")
  trailerHandoffs        EquipmentHandoff[] @relation("TrailerHandoff")
}