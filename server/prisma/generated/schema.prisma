// Generated from prisma/models/*.prisma
// Keep the model definitions in separate files for easier edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// prisma/models/airline.prisma
model Airline {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  awbPrefix           String   @unique
  logoUrl             String?  @db.VarChar(255)
  terminalAddress     String?
  contactPhone        String?  @db.VarChar(20)
  openTime            String?  @db.VarChar(5)
  closeTime           String?  @db.VarChar(5)
  open24h             Boolean  @default(false)
  defaultCutoffHours  Int      @default(4)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shipments Shipment[]
}
// prisma/models/driver.prisma
model Driver {
  id                    String   @id @default(cuid())
  // ─── IDENTITY ───
  name                  String
  employeeId            String   @unique
  phone                 String   @db.VarChar(20)
  email                 String   @db.VarChar(100)
  photo                 String?  @db.VarChar(255)
  address               String?
  dateOfBirth           DateTime?
  gender                String?  @db.VarChar(10)
  
  // ─── AVAILABILITY ───
  status                String   @default("Available")
  statusReason          String?
  leaveStart            DateTime?
  leaveEnd              DateTime?
  
  // ─── SCHEDULE ───
  schedule              String   @db.VarChar(100)
  shiftStart            String?  @db.VarChar(5)
  shiftEnd              String?  @db.VarChar(5)
  daysOff               String[]
  availableOnDaysOff    Boolean  @default(false)
  overtimePreference    Boolean  @default(false)
  maxWeeklyHours        Int      @default(60)
  
  // ─── VEHICLE ELIGIBILITY ───
  licenseNumber         String?
  licenseClass          String   @default("A") @db.VarChar(1)
  licenseExpiration     DateTime?
  licensePhoto          String?  @db.VarChar(255)
  medicalCertExpiration DateTime?
  endorsements          String[]
  vehicleTypes          String[]
  trailerEligible       Boolean  @default(true)
  hazmatCertified       Boolean  @default(false)
  gdpTrained            Boolean  @default(false)
  
  // ─── TRACKING ───
  currentLocation       String?  
  currentLatitude       Float?
  currentLongitude      Float?
  lastCheckin           DateTime?
  hoursDrivenToday      Float    @default(0)
  onDutyHours           Float    @default(0)
  lastBreakTime         DateTime?
  breakUntil            DateTime?
  shiftStartTime        DateTime?
  shiftEndTime          DateTime?
  
  // ─── PREFERENCES ───
  preferredRunTypes     String[]
  homeBase              String?  
  maxRadius             Int?     
  overnightAllowed      Boolean  @default(true)
  crossBorder           Boolean  @default(false)
  
  // ─── PERFORMANCE ───
  performanceRating     Float?   @default(3.0)
  totalTripsCompleted   Int      @default(0)
  onTimeDeliveryRate    Float?   @default(100.0)
  safetyScore           Float?   @default(100.0)
  incidents             Int      @default(0)
  
  // ─── COMPENSATION ───
  hireDate              DateTime?
  employmentStatus      String   @default("Active")
  payType               String   @default("Hourly")
  payRate               Float    @default(0)
  overtimeRate          Float?   
  bonusEligible         Boolean  @default(false)
  lastPayRaise          DateTime?
  
  // ─── CONTACT ───
  emergencyContactName  String?
  emergencyContactPhone String?  @db.VarChar(20)
  emergencyContactRelation String?
  
  // ─── NOTES ───
  notes                 String?
  specialSkills         String?
  medicalConditions     String?  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // ─── RELATIONS ───
  trips                 Trip[]
  assignedEquipment     Equipment[]
  equipmentHandoffs     EquipmentHandoff[]                    // primary driver on the handoff
  handoffsAsApprover    EquipmentHandoff[] @relation("ApproverDriver")  // when this driver is the dispatcher/approver
}
model Equipment {
  id                     String   @id @default(cuid())
  unitNumber             String   @unique
  equipmentType          String
  category               String
  status                 String   @default("In Service")
  licensePlate           String?
  vin                    String?
  year                   Int?
  modelDetails           String?
  capacityLbs            Int?
  palletPositions        Int?
  registrationExpiration DateTime?
  nextMaintenanceDue     DateTime?
  outOfServiceReason     String?
  notes                  String?

  // ─── INSURANCE ───
  insuranceProvider      String?
  insurancePolicyNumber  String?
  insuranceExpiration    DateTime?

  // ─── IFTA / IRP ───
  iftaIrpExpiration      DateTime?

  // ─── OWNERSHIP / LEASE ───
  ownershipType          String   @default("Owned")
  leaseCompany           String?
  leaseEndDate           DateTime?
  monthlyPaymentAmount   Float?

  // ─── HANDOFF BOARD ───
  assignedDriverId       String?
  assignedDriver         Driver?  @relation(fields: [assignedDriverId], references: [id])
  availableAt            DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // ─── RELATIONS ───
  tripsAsTruck    Trip[] @relation("TruckTrips")
  tripsAsTrailer  Trip[] @relation("TrailerTrips")
  handoffs        EquipmentHandoff[]  // All checkout/return records
  handoffsAsReplaced EquipmentHandoff[] @relation("ReplacedEquipment")
  trailerHandoffs     EquipmentHandoff[] @relation("TrailerHandoff")
}
// prisma/models/equipment_handoff.prisma

enum EquipmentHandoffAction {
  CHECKOUT
  SWAP
  RETURN
  REPLACE
}

enum EquipmentHandoffReason {
  SHIFT_START
  SHIFT_END
  MECHANICAL
  MAINTENANCE
  ROUTE_CHANGE
  DRIVER_REQUEST
  DISPATCH
  EMERGENCY
  TRAILER_SWAP
  RELOCATION
  BREAKDOWN
}

model EquipmentHandoff {
  id              String   @id @default(cuid())
  
  // What happened
  action          EquipmentHandoffAction
  reason          EquipmentHandoffReason?
  reasonNote      String?
  
  // Who - Driver (primary)
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id])
  
  // Who - Dispatcher (optional approver)
  dispatcherId    String?
  dispatcher      Driver?  @relation("ApproverDriver", fields: [dispatcherId], references: [id])
  
  // Equipment involved (primary)
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  
  // For swaps: what was replaced
  replacedEquipmentId String?
  replacedEquipment   Equipment? @relation("ReplacedEquipment", fields: [replacedEquipmentId], references: [id])
  
  // Trailer tracking
  trailerId       String?
  trailer         Equipment? @relation("TrailerHandoff", fields: [trailerId], references: [id])
  previousTrailerId String?
  
  // Timing
  checkOutTime    DateTime @default(now())
  returnTime      DateTime?
  shiftStartTime  DateTime?
  shiftEndTime    DateTime?
  
  // Location
  checkOutLocation String?
  returnLocation  String?
  
  // Vehicle data
  odometerStart   Int?
  fuelLevelStart  String?
  odometerEnd     Int?
  fuelLevelEnd    String?
  
  // Condition checks
  preTripCompleted Boolean @default(false)
  preTripNotes    String?
  postTripCompleted Boolean @default(false)
  postTripNotes   String?
  
  // Damage reporting
  damageReported  Boolean @default(false)
  damageDescription String?
  damagePhoto     String?
  
  // Status tracking
  isActive        Boolean @default(true)
  returnedBy      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([driverId])
  @@index([equipmentId])
  @@index([trailerId])
  @@index([checkOutTime])
  @@index([isActive])
  @@index([action])
}
model Shipment {
  id                    String   @id @default(cuid())
  type                  String   // "Import" or "Export"
  status                String   @default("Pending")

  // Common fields
  pieces                Int
  weight                Float
  weightUnit            String   @default("lb") // "lb" or "kg"
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Common AWB for both types
  airwaybillNumber      String?  // Full AWB: prefix + 8 digits
  pmcCount              Int      @default(0) // Number of PMCs (pallets)

  // Import-specific fields
  ordNumber             String?  // ORD number for imports only
  lastFreeDay           DateTime?
  storageFeePerDay      Float    @default(0)
  storageFeeDaysOver    Int      @default(0)
  storageFeePaid        Boolean  @default(false)
  terminalFee           Float    @default(0)
  terminalFeePaid       Boolean  @default(false)
  isGDP                 Boolean  @default(false) // Temperature controlled
  gdpTemperatureRange   String?  // e.g., "2-8°C", "15-25°C"

  // Export-specific fields
  flightDate            DateTime?
  lockoutTime           DateTime?
  trailerNumber         String?
  doorNumber            String?
  truckType             String?  // "Straight" or "Cube"
  pickupReadyAt         DateTime?
  deliveryAppointmentAt DateTime?

  // Relations
  airlineId   String?
  warehouseId String?
  airline     Airline?   @relation(fields: [airlineId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  trips       Trip[]     @relation("ShipmentTrips")

  // Per-trip pieces/weight when this AWB is split across a primary run
  // and one or more backup runs (see TripShipmentSplit in trip.prisma).
  tripSplits  TripShipmentSplit[]

  // Many-to-many for grouping shipments (e.g., same truck load)
  shipmentGroups ShipmentGroupShipment[]
}

// For grouping multiple shipments (e.g., same truck load)
model ShipmentGroup {
  id          String   @id @default(cuid())
  name        String   // e.g., "TRUCK-123-2026-01-28"
  type        String   // "Import" or "Export"
  truckType   String?  // "Straight" or "Cube"
  trailerNumber String?
  doorNumber  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipments   ShipmentGroupShipment[]
}

model ShipmentGroupShipment {
  shipmentId      String
  shipmentGroupId String
  addedAt         DateTime @default(now())

  shipment      Shipment      @relation(fields: [shipmentId], references: [id])
  shipmentGroup ShipmentGroup @relation(fields: [shipmentGroupId], references: [id])

  @@id([shipmentId, shipmentGroupId])
}

// ============================================================
// MODEL: TripSequence
// Atomic counter for generating unique trip numbers.
// The database locks this row during concurrent transactions.
// ============================================================
model TripSequence {
  id       Int @id @default(1)
  lastUsed Int @default(0)
}
// prisma/models/trip.prisma
model Trip {
  id                       String   @id @default(cuid())
  tripNumber               String   @unique
  runType                  String
  plannedDepartureTime     DateTime?
  expectedCompletionTime   DateTime?
  startTime                DateTime?
  finishTime               DateTime?
  status                   String   @default("Scheduled")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  driverId   String?
  truckId    String?
  trailerId  String?
  driver     Driver?    @relation(fields: [driverId], references: [id])
  truck      Equipment? @relation("TruckTrips", fields: [truckId], references: [id])
  trailer    Equipment? @relation("TrailerTrips", fields: [trailerId], references: [id])

  shipmentIds String[]
  shipments   Shipment[] @relation("ShipmentTrips")

  // ─── BACKUP / SPLIT RUNS ───
  // When one truck/trailer can't take the whole manifest, a backup trip is
  // created and linked back to the original run it was split from. The
  // parent stays the "primary" trip; children are the backup driver(s).
  parentTripId String?
  parentTrip   Trip?   @relation("TripSplits", fields: [parentTripId], references: [id])
  splitTrips   Trip[]  @relation("TripSplits")

  // How much of a given AWB (Shipment) is actually riding on THIS trip.
  // Only populated once a shipment's pieces/weight are divided across more
  // than one trip — an unsplit shipment on a single trip is assumed to
  // carry that shipment's full pieces/weight.
  shipmentSplits TripShipmentSplit[]
}

// One AWB permit is sometimes too big for one trailer. This table records
// how many pieces / how much weight of a single Shipment are assigned to
// a specific Trip, so a permit can be divided across a primary run and one
// or more backup runs without losing track of the total.
model TripShipmentSplit {
  id         String   @id @default(cuid())
  tripId     String
  shipmentId String
  pieces     Int
  weight     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([tripId, shipmentId])
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
// prisma/models/warehouse.prisma
model Warehouse {
  id              String   @id @default(cuid())
  name            String
  address         String?
  contactPhone    String?  @db.VarChar(20)
  is24Hours       Boolean  @default(false)
  daysOpen        String[] @default([])
  openTime        String?  @db.VarChar(5)
  closeTime       String?  @db.VarChar(5)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shipments Shipment[]
}
